# Defaults for mac-sandbox. Every value can be overridden by an environment
# variable, by `./install.sh host VAR=value`, or in config.local.env.

# Cirrus Labs image with Xcode, Ruby (rbenv), Node 24, Homebrew, Codex and Claude Code.
# The guest macOS must not be newer than the host macOS: use macos-golden-gate-xcode:27
# only on hosts running macOS 27.
: "${BASE_IMAGE:=ghcr.io/cirruslabs/macos-tahoe-xcode:27}"

# Setup steps run in the template, in order. Each name is a script in guest/setup/<name>.sh.
# Tools themselves are listed in guest/mise.toml. Changing either requires rebuilding the template.
: "${SETUP:=xcode mise claude paseo}"

# Local name of the provisioned template VM that sandboxes are cloned from.
: "${TEMPLATE:=agent-xcode27}"

# OCI reference of a template you pushed earlier (e.g. ghcr.io/you/agent-xcode27:latest).
# When set, hosts pull it instead of building the template themselves.
: "${TEMPLATE_SOURCE:=}"

# Sandbox VMs on this host. macOS licensing allows at most two macOS VMs running per host.
: "${VMS:=sbx-1 sbx-2}"

# Empty means: derived from the host's hardware (see host/bootstrap.sh).
: "${VM_CPU:=}"
: "${VM_MEMORY_MB:=}"
: "${VM_DISK_GB:=200}"

# Directory (relative to $HOME) where this repo is copied on the host.
: "${HOST_DIR:=mac-sandbox}"
